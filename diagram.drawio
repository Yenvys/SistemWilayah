  <diagram name="Class Diagram (SOLID Principles)" id="siwil-class-solid">
    <mxGraphModel dx="2600" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- HEADER TITLE -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#0F172A;" value="UML CLASS DIAGRAM - ARSITEKTUR BERORIENTASI OBJEK &amp; KEPATUHAN PRINSIP SOLID (SIWIL)" vertex="1">
          <mxGeometry x="300" y="15" width="2000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=2;fontColor=#334155;" value="Penerapan 5 Prinsip SOLID: SRP (Controller Layer) | OCP &amp; DIP (Service Abstraction) | LSP (Model Eloquent) | ISP (Form Requests &amp; Repositories)" vertex="1">
          <mxGeometry x="300" y="55" width="2000" height="25" as="geometry" />
        </mxCell>

        <!-- ================================================================= -->
        <!-- LAYER 1: CONTROLLER & PRESENTATION LAYER (SRP)                    -->
        <!-- ================================================================= -->
        <mxCell id="lay_ctrl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#1E3A8A;strokeWidth=2;verticalAlign=top;spacingTop=10;fontStyle=1;fontSize=13;fontColor=#1E3A8A;dashed=1;" value="LAYER 1: PRESENTATION &amp; CONTROLLER LAYER (Single Responsibility Principle - SRP)" vertex="1">
          <mxGeometry x="50" y="90" width="2480" height="280" as="geometry" />
        </mxCell>

        <!-- UserController -->
        <mxCell id="c_user_ctrl" parent="1" style="verticalAlign=top;align=left;overflow=fill;fontSize=10;fontFamily=Helvetica;html=1;rounded=1;strokeColor=#1E3A8A;fillColor=#FFFFFF;strokeWidth=2;fontColor=#0F172A;shadow=1;" value="&lt;div style=&quot;background-color:#1E3A8A;color:#FFFFFF;padding:6px 4px;text-align:center;font-weight:bold;font-size:11px;border-top-left-radius:4px;border-top-right-radius:4px;&quot;&gt;UserController&lt;/div&gt;&lt;div style=&quot;padding:6px;color:#1E293B;font-size:10px;background-color:#FFFFFF;&quot;&gt;- userService: UserServiceInterface&lt;br/&gt;- authManager: AuthManager&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1.5px solid #CBD5E1;margin:2px 0;&quot;/&gt;&lt;div style=&quot;padding:6px;color:#0F172A;font-size:10px;background-color:#FFFFFF;&quot;&gt;+ register(RegisterRequest): JsonResponse&lt;br/&gt;+ login(LoginRequest): Response&lt;br/&gt;+ verifyOtp(OtpRequest): Response&lt;br/&gt;+ approveCitizenAccount(userId): Json&lt;/div&gt;" vertex="1">
          <mxGeometry x="80" y="130" width="280" height="210" as="geometry" />
        </mxCell>

        <!-- DocumentRequestController -->
        <mxCell id="c_doc_ctrl" parent="1" style="verticalAlign=top;align=left;overflow=fill;fontSize=10;fontFamily=Helvetica;html=1;rounded=1;strokeColor=#1E3A8A;fillColor=#FFFFFF;strokeWidth=2;fontColor=#0F172A;shadow=1;" value="&lt;div style=&quot;background-color:#1E3A8A;color:#FFFFFF;padding:6px 4px;text-align:center;font-weight:bold;font-size:11px;border-top-left-radius:4px;border-top-right-radius:4px;&quot;&gt;DocumentRequestController&lt;/div&gt;&lt;div style=&quot;padding:6px;color:#1E293B;font-size:10px;background-color:#FFFFFF;&quot;&gt;- docApprovalService: DocumentApprovalInterface&lt;br/&gt;- notifService: NotificationInterface&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1.5px solid #CBD5E1;margin:2px 0;&quot;/&gt;&lt;div style=&quot;padding:6px;color:#0F172A;font-size:10px;background-color:#FFFFFF;&quot;&gt;+ store(StoreDocRequest): Redirect&lt;br/&gt;+ approveRt(Request, id): Json&lt;br/&gt;+ approveRw(Request, id): Json&lt;br/&gt;+ approveDesa(Request, id): Json&lt;br/&gt;+ downloadPdf(id): BinaryFileResponse&lt;/div&gt;" vertex="1">
          <mxGeometry x="400" y="130" width="310" height="210" as="geometry" />
        </mxCell>

        <!-- AiChatController -->
        <mxCell id="c_ai_ctrl" parent="1" style="verticalAlign=top;align=left;overflow=fill;fontSize=10;fontFamily=Helvetica;html=1;rounded=1;strokeColor=#1E3A8A;fillColor=#FFFFFF;strokeWidth=2;fontColor=#0F172A;shadow=1;" value="&lt;div style=&quot;background-color:#1E3A8A;color:#FFFFFF;padding:6px 4px;text-align:center;font-weight:bold;font-size:11px;border-top-left-radius:4px;border-top-right-radius:4px;&quot;&gt;AiChatController&lt;/div&gt;&lt;div style=&quot;padding:6px;color:#1E293B;font-size:10px;background-color:#FFFFFF;&quot;&gt;- aiService: AiProviderInterface&lt;br/&gt;- guardrail: UuPdpGuardrailService&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1.5px solid #CBD5E1;margin:2px 0;&quot;/&gt;&lt;div style=&quot;padding:6px;color:#0F172A;font-size:10px;background-color:#FFFFFF;&quot;&gt;+ sendMessage(AiPromptRequest): StreamedResponse&lt;br/&gt;+ getConversationHistory(userId): Json&lt;br/&gt;+ switchModelProvider(Request): Json&lt;/div&gt;" vertex="1">
          <mxGeometry x="750" y="130" width="310" height="210" as="geometry" />
        </mxCell>

        <!-- EmergencyController -->
        <mxCell id="c_sos_ctrl" parent="1" style="verticalAlign=top;align=left;overflow=fill;fontSize=10;fontFamily=Helvetica;html=1;rounded=1;strokeColor=#1E3A8A;fillColor=#FFFFFF;strokeWidth=2;fontColor=#0F172A;shadow=1;" value="&lt;div style=&quot;background-color:#1E3A8A;color:#FFFFFF;padding:6px 4px;text-align:center;font-weight:bold;font-size:11px;border-top-left-radius:4px;border-top-right-radius:4px;&quot;&gt;EmergencyController&lt;/div&gt;&lt;div style=&quot;padding:6px;color:#1E293B;font-size:10px;background-color:#FFFFFF;&quot;&gt;- emergencyService: EmergencyServiceInterface&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1.5px solid #CBD5E1;margin:2px 0;&quot;/&gt;&lt;div style=&quot;padding:6px;color:#0F172A;font-size:10px;background-color:#FFFFFF;&quot;&gt;+ triggerSos(SosRequest): JsonResponse&lt;br/&gt;+ resolveIncident(id): JsonResponse&lt;br/&gt;+ getLiveCoordinates(): JsonResponse&lt;/div&gt;" vertex="1">
          <mxGeometry x="1100" y="130" width="290" height="210" as="geometry" />
        </mxCell>

        <!-- ComplaintController -->
        <mxCell id="c_comp_ctrl" parent="1" style="verticalAlign=top;align=left;overflow=fill;fontSize=10;fontFamily=Helvetica;html=1;rounded=1;strokeColor=#1E3A8A;fillColor=#FFFFFF;strokeWidth=2;fontColor=#0F172A;shadow=1;" value="&lt;div style=&quot;background-color:#1E3A8A;color:#FFFFFF;padding:6px 4px;text-align:center;font-weight:bold;font-size:11px;border-top-left-radius:4px;border-top-right-radius:4px;&quot;&gt;ComplaintController&lt;/div&gt;&lt;div style=&quot;padding:6px;color:#1E293B;font-size:10px;background-color:#FFFFFF;&quot;&gt;- complaintService: ComplaintServiceInterface&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1.5px solid #CBD5E1;margin:2px 0;&quot;/&gt;&lt;div style=&quot;padding:6px;color:#0F172A;font-size:10px;background-color:#FFFFFF;&quot;&gt;+ store(ComplaintRequest): Redirect&lt;br/&gt;+ updateStatus(id, Request): Json&lt;br/&gt;+ getGisGeoJson(): JsonResponse&lt;/div&gt;" vertex="1">
          <mxGeometry x="1430" y="130" width="290" height="210" as="geometry" />
