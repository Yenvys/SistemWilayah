  <diagram name="Activity Diagram - Pelayanan Persuratan &amp; TTE" id="siwil-activity-persuratan">
    <mxGraphModel dx="2800" dy="2100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="2100" math="0" shadow="0">
