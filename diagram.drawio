        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;align=left;verticalAlign=middle;fontSize=10;spacingLeft=12;strokeWidth=1.5;" value="LEGENDA STANDAR UML &amp; KATEGORI WARNA PENGHUBUNG AKTOR:&#10;â€¢ â€”â€”â€” Garis Solid Biru         : Relasi Warga (Main Citizen Actor) â†” Layanan Mandiri, Dokumen &amp; Interaksi Warga&#10;â€¢ â€”â€”â€” Garis Solid Hijau Emerald : Relasi Ketua RT (Verifikator Tingkat 1) â†” Verifikasi Berkas, Data RT, &amp; Pengantar RT&#10;â€¢ â€”â€”â€” Garis Solid Teal/Cyan    : Relasi Ketua RW (Verifikator Tingkat 2) â†” Verifikasi Berkas, Data RW, &amp; Pengantar RW&#10;â€¢ â€”â€”â€” Garis Solid Oranye Bata  : Relasi Admin Desa / Kades (Pemerintah Desa) â†” Otorisasi Surat, TTE, APBDes &amp; GIS&#10;â€¢ â€”â€”â€” Garis Solid Ungu         : Relasi Superadmin â†” Konfigurasi, Hak Akses &amp; Audit Sistem&#10;â€¢ â€”â€”â€” Garis Solid Abu-abu      : Relasi Masyarakat / Publik (Tanpa Login) â†” Beranda Publik, Statistik &amp; APBDes&#10;â€¢ â€”â€”â€” Garis Solid Merah        : Panggilan Darurat SOS (Keandalan Tinggi &amp; Broadcast Insiden)&#10;â€¢ â€”â€”â€” Garis Solid Kuning Emas   : Relasi SIWIL AI Engine &amp; 12 Function Calling Tools&#10;â€¢ - - - &gt; Garis Putus Biru       : Relasi &lt;&lt;include&gt;&gt; (Use case prasyarat/wajib dieksekusi)&#10;â€¢ - - - &gt; Garis Putus Oranye     : Relasi &lt;&lt;extend&gt;&gt; (Use case perluasan/cabang kondisional)&#10;â€¢ Warna Kotak Modul: [Hijau: Persuratan] â€¢ [Merah: Pengaduan/SOS] â€¢ [Ungu: Musyawarah] â€¢ [Kuning: AI &amp; Tools] â€¢ [Biru: Publik &amp; Warga] â€¢ [Abu-abu: Master &amp; Sistem]" vertex="1">
          <mxGeometry height="120" width="2280" x="260" y="1805" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
