        <mxCell id="CY5MxavKzUyDetMzdxGO-170" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;align=left;verticalAlign=middle;fontSize=10;spacingLeft=12;strokeWidth=1.5;" value="LEGENDA STANDAR UML &amp;amp; KATEGORI WARNA PENGHUBUNG AKTOR:&lt;br&gt;&amp;nbsp;Garis Solid Biru         : Relasi Warga (Main Citizen Actor) &#226;&#8224;&#8221; Layanan Mandiri, Dokumen &amp;amp; Interaksi Warga&lt;br&gt;&amp;nbsp;Garis Solid Hijau Emerald : Relasi Ketua RT (Verifikator Tingkat 1) &#226;&#8224;&#8221; Verifikasi Berkas, Data RT, &amp;amp; Pengantar RT&lt;br&gt;&amp;nbsp;Garis Solid Teal/Cyan    : Relasi Ketua RW (Verifikator Tingkat 2) &#226;&#8224;&#8221; Verifikasi Berkas, Data RW, &amp;amp; Pengantar RW&lt;br&gt;&amp;nbsp;Garis Solid Oranye Bata  : Relasi Admin Desa / Kades (Pemerintah Desa) &#226;&#8224;&#8221; Otorisasi Surat, TTE, APBDes &amp;amp; GIS&lt;br&gt;&amp;nbsp;Garis Solid Ungu         : Relasi Superadmin &#226;&#8224;&#8221; Konfigurasi, Hak Akses &amp;amp; Audit Sistem&lt;br&gt;&amp;nbsp;Garis Solid Abu-abu      : Relasi Masyarakat / Publik (Tanpa Login) &#226;&#8224;&#8221; Beranda Publik, Statistik &amp;amp; APBDes&lt;br&gt;&amp;nbsp;Garis Solid Merah        : Panggilan Darurat SOS (Keandalan Tinggi &amp;amp; Broadcast Insiden)&lt;br&gt;&amp;nbsp;Garis Solid Kuning Emas   : Relasi SIWIL AI Engine &amp;amp; 12 Function Calling Tools&lt;br&gt;&amp;nbsp;- - - &amp;gt; Garis Putus Biru       : Relasi &amp;lt;&amp;gt; (Use case prasyarat/wajib dieksekusi)&lt;br&gt;&amp;nbsp;- - - &amp;gt; Garis Putus Oranye     : Relasi &amp;lt;&amp;gt; (Use case perluasan/cabang kondisional)&lt;br&gt;&amp;nbsp;Warna Kotak Modul: [Hijau: Persuratan],&amp;nbsp; [Merah: Pengaduan/SOS],&amp;nbsp; [Ungu: Musyawarah],&amp;nbsp; [Kuning: AI &amp;amp; Tools],&amp;nbsp; [Biru: Publik &amp;amp; Warga],&amp;nbsp; [Abu-abu: Master &amp;amp; Sistem]" vertex="1">
          <mxGeometry height="170" width="2280" x="540" y="2000" as="geometry" />
        </mxCell>
